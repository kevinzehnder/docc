</w:r>
<w:r>
<w:rPr>
<w:rStyle w:val="ParteiName"/>
</w:rPr>
<w:t xml:space="preserve">Peter Muster</w:t>
</w:r>
<w:r>
<w:t xml:space="preserve">:</w:t>
</w:r>
<w:r>
<w:tab/>
</w:r>
<w:r>
