</w:p>
<w:p>
<w:pPr>
<w:pStyle w:val="Unterschriftsrolle"/>
</w:pPr>
<w:r>
<w:t xml:space="preserve">Die Käuferschaft:</w:t>
</w:r>
</w:p>
<w:p>
<w:pPr>
<w:pStyle w:val="Unterschriftslinie"/>
</w:pPr>
<w:r>
<w:rPr>
<w:rStyle w:val="ParteiName"/>
</w:rPr>
<w:t xml:space="preserve">Beispiel Immobilien AG</w:t>
</w:r>
<w:r>
<w:t xml:space="preserve">:</w:t>
</w:r>
<w:r>
<w:tab/>
</w:r>
<w:r>
